// Write a Java program to check whether a specific number is a Perfect Number or not
// by using a function with argument and return type.

import java.util.*;

class Main {

    boolean perfect(int n) {

        int sum = 0;

        for (int i = 1; i <= n / 2; i++) {

            if (n % i == 0) {
                sum = sum + i;
            }
        }

        if (sum == n) {
            return true;
        }
        else {
            return false;
        }
    }

    public static void main(String args[]) {

        Main s = new Main();

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        boolean ans = s.perfect(n);

        if (ans) {
            System.out.println("Perfect Number");
        }
        else {
            System.out.println("Not a Perfect Number");
        }
    }
}

