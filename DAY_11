// Write a Java program to find the smallest element in an array

import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int min = arr[0];

        for (int i = 1; i < n; i++) {

            if (arr[i] < min) {
                min = arr[i];
            }
        }

        System.out.println("Smallest element is " + min);
    }
}

