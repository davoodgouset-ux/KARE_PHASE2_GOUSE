        if(nums>first){
            third=second;
            second=first;
            first=nums;
        }
        else if(nums>second && nums!=first){
            third=second;
            second=nums;
        }
        
    }
    for(int i=0;i<n;i++){
        System.out.print(second+" ");
    }
	}
