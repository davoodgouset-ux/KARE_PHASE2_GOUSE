import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int a[]=new int[n];
		for(int i=0; i<n; i++) {
			a[i]=sc.nextInt();
		}
		int target =sc.nextInt();
		int left=0;
		int right=n-1;
		while(left<right){
		    int sum=a[left]+a[right];
		    if(sum==target){
		        System.out.print(left+ " "+right+" = "+ (a[left]+a[right]));
		        return;
		    }
		    else if(sum<target){
		        left++;
		    }
		    else{
		        right--;
		    }
		}
	}
}

