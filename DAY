import java.util.*;
public class Main
{
	public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int a[]=new int[n];
    for(int i=0;i<n;i++){
        a[i]=sc.nextInt();
    }
    int count=0;
    int arr[]=new int [n];
    int max=Integer.MIN_VALUE;
    for(int i=n-1;i>=0;i--){
        if(a[i]>max){
            max=a[i];
            arr[count]=a[i];
            count++;
        }
    }
    for(int i=count-1;i>=0;i--){
        System.out.print(arr[i]+" ");
    }
	}
}
