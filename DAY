        int n=sc.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=sc.nextInt();
        }
        int low=0;
        int high=n-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(a[mid]==target){
                System.out.print("Element found at index: "+mid+"\ntarget is: "+a[mid]);
                return;
            }
            else if(a[mid]<target){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
    }
