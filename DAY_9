public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
    System.out.print("ENter size of array");
		int n=sc.nextInt();
		int a[]=new int[n];
		for(int i=0;i<n;i++){
		    a[i]=sc.nextInt();
		}
		int m=0;
		for(int i=0;i<n;i++){
		    m=m^a[i];
		}
		System.out.print("Single number is :"+m);
	}
}
