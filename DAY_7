Strong Number*/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();//n=145;
		int temp=n;
		int d;
		int fact=1,sum=0;
		while(n!=0){
		    fact=1;
		    d=n%10;
		    for(int i=1;i<=d;i++){
		        fact=fact*i;
		    }
		    sum+=fact;
		    n=n/10;
		}if(temp==sum){
		    System.out.print("Strong NUmber: "+sum);
		}else{
		    System.out.print("not  a strong number: "+sum);
		}
		
	}
}
