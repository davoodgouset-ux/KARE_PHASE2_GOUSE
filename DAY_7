        for(int i=1;i<=n1/2;i++){
            if(n1%i==0){
                n1sum+=i;
            }
        }
        int n2sum=0;
        for(int i=1;i<=n2/2;i++){
            if(n2%i==0){
                n2sum+=i;
            }
