        System.out.print("Enter n value: ");
        int n = sc.nextInt();
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
            if(i==j || i+j==n-1)
                System.out.print("*");
            else
            System.out.print(" ");
