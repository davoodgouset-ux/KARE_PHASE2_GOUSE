//2d array input print
import java.util.*;
public class Matrix2d{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        System.out.print("Enter no.of rows: ");
        int r=sc.nextInt();
        System.out.print("ENter no.of columns: ");
        int c=sc.nextInt();
        int arr[][]=new int[r][c];
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                arr[i][j]=sc.nextInt();
            }
        }
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                System.out.print(arr[i][j]+" ");
            }
            System.out.println();
        }
        

    }
}
