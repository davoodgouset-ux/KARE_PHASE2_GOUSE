//Wjp to check a specific number is perfect square of not by using function with no argument no return type
import java.util.*;
public class Main
{
    
    static void ps(){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int flag=0,i;
        for(i=1;i<=n/2;i++){
            if(i*i==n){
                flag=1;
                System.out.print("Perfect Number");
                break;
            }
            }
            if(flag==0){
                System.out.print("Not a perfect square");
        }
    }
	public static void main(String[] args) {
    
    ps();
	}
}
