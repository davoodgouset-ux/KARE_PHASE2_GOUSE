5. Queue Using ArrayDeque – Remove All Elements
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        Queue<Integer> obj = new ArrayDeque<>();

        System.out.print("Enter number of elements: ");
        int n = s.nextInt();

        System.out.println("Enter elements:");

        for (int i = 0; i < n; i++) {
            obj.offer(s.nextInt());
        }

        System.out.println("Original Queue: " + obj);

        while (!obj.isEmpty()) {
            System.out.println("Deleted: " + obj.poll());
        }

        System.out.println("Queue is empty");
    }
}
