//search an element in an array and return its index
import java.util.*;
public class Arraygo{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        System.out.print("Enter which elements to seach: ");
        int f=sc.nextInt();
        for(int i=0;i<n;i++){
            if(arr[i]==f){
                System.out.print(arr[i]+" found in "+i+" th index");
                return;
            }
        }
        System.out.println("Not found");
    }
}

