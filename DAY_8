//reverse same array elements by changing the original array 
import java.util.*;
public class Arrreverse{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        int left,right;
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
              left=0;
              right=n-1;
           while(left<right){
            int temp=arr[left];
            arr[left]=arr[right];
            arr[right]=temp;
            left++;
            right--;
        }
        for(int i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
}
