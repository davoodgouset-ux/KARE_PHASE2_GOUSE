//associvity rule from left right since both / and * are same
import java.util.Scanner;
class Main{
    public static void main(String[] args){
    Scanner sc = new Scanner(System.in);
       if(!true)
       System.out.println(9+5);
       else
       System.out.println(5+6/2*10);
    }
}//35

